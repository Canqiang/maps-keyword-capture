{
  "name": "maps-keyword-capture",
  "version": "0.1.0",
  "private": true,
  "description": "Keyword-first Google Maps listing and screenshot capture, including clearly identified ads.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test:contracts": "tsc -p tsconfig.contract-tests.json --noEmit",
    "test:unit": "vitest run",
    "test": "npm run test:contracts && npm run test:unit",
    "build": "tsc -p tsconfig.build.json",
    "capture": "tsx src/cli.ts"
  },
  "dependencies": {
    "playwright": "1.63.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "22.20.3",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  }
}
